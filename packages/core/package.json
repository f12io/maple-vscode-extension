{
  "name": "@f12io/maple-language-core",
  "version": "0.0.14",
  "description": "Editor-agnostic language tooling for the Maple CSS: region discovery, class extraction, and the class formatter shared by the VS Code extension and the Prettier plugin.",
  "license": "ROOT",
  "author": "f12.io",
  "homepage": "https://github.com/f12io/maple-vscode-extension/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f12io/maple-vscode-extension.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/f12io/maple-vscode-extension/issues"
  },
  "keywords": [
    "maple",
    "css",
    "utility-classes",
    "formatter",
    "language-tools"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@f12io/coco": "^2.1.9",
    "@f12io/maple": "^2.0.21"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=18"
  }
}
